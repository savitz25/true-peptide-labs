{
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "www.vialvibes.com" }], "destination": "https://vialvibes.com/", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.vialvibes.com" }], "destination": "https://vialvibes.com/:path*", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/peptide-calculator.html", "destination": "/tools/peptide-calculator.html", "permanent": true },
    { "source": "/stack-builder.html", "destination": "/tools/research-combination-builder.html", "permanent": true },
    { "source": "/peptides", "destination": "/peptides/", "permanent": true },
    { "source": "/research", "destination": "/research/", "permanent": true },
    { "source": "/cart.html", "destination": "/", "permanent": true },
    { "source": "/checkout.html", "destination": "/", "permanent": true }
  ],
  "cleanUrls": false,
  "functions": {
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
