# Resend (set these in Vercel → Project → Settings → Environment Variables)
RESEND_API_KEY=re_xxxxxxxx

# Verified sending domain addresses
EMAIL_FROM_RESEARCH=VialVibes Research <research@vialvibes.com>
EMAIL_FROM_ORDERS=VialVibes Orders <orders@vialvibes.com>

# Where form submissions and inbound forwards should be delivered
EMAIL_FORWARD_TO=info@movetrusthub.com

# Optional: also CC research inbox for records (leave empty to skip)
EMAIL_CC=

# Optional: shared secret for Resend inbound webhook verification
RESEND_WEBHOOK_SECRET=

# Public site URL (used in email footers)
SITE_URL=https://vialvibes.com
